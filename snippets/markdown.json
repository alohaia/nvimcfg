{
    "File name": {
        "prefix": "file",
        "body": ["$TM_FILENAME"],
        "description": "Current file name with suffix"
    },
    "Anchor": {
        "prefix": "anc",
        "body": ["[${1:${VISUAL}}](#${2:$1/\\s+/-/g})$0"]
    },
    "Equation": {
        "prefix": "equ",
        "body": [
            "\\$\\$\\begin{equation}",
            "$1",
            "\\label{eq:${2:label}}",
            "\\end{equation}\\$\\$$0"
        ]
    },
    "Equation Reference": {
        "prefix": "eqr",
        "body": ["\\$\\eqref{eq:${1:label}}$0\\$"]
    }
}
